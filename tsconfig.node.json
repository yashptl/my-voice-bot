{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": [
    "scripts",
    "probes",
    "evals",
    "tests",
    "src/protocol",
    "src/ports",
    "src/core",
    "src/adapters",
    "src/knowledge",
    "*.config.ts",
    "**/*.test.ts"
  ],
  // Client tests need DOM types: tsconfig.client.json checks them.
  "exclude": ["src/client", "playground", "node_modules"]
}
