{
  "name": "yashos-assistant",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A voice and text assistant that tells recruiters about Yash's work.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run db:migrate:local && vite dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to playground/.wrangler/state",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run knowledge:check",
    "knowledge:sync": "tsx scripts/knowledge-sync.ts",
    "knowledge:build": "tsx scripts/knowledge-build.ts",
    "knowledge:check": "tsx scripts/knowledge-build.ts --check",
    "probe:llm": "tsx probes/llm.ts",
    "probe:tts": "tsx probes/tts.ts",
    "probe:redirect": "tsx probes/redirect.ts",
    "eval": "tsx evals/run.ts",
    "eval:judge": "tsx evals/judge-check.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261107.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
